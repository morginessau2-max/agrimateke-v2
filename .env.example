# ─────────────────────────────────────────────────────────
# AgriMateKE Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values
# cp .env.example .env
# Never commit your actual .env file to GitHub
# ─────────────────────────────────────────────────────────

# ANTHROPIC API KEY
# Powers Shamba Bot AI assistant
# Get yours at: https://console.anthropic.com
# Free $5 credits on signup
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────────────────────
# COMING IN PHASE 3 — SUPABASE
# ─────────────────────────────────────────────────────────

# SUPABASE PROJECT URL
# Get from: https://supabase.com → Your Project → Settings → API
# VITE_SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE ANON KEY (public, safe to expose to client)
# Get from: https://supabase.com → Your Project → Settings → API
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─────────────────────────────────────────────────────────
# COMING IN PHASE 5 — PAYMENTS & SMS
# ─────────────────────────────────────────────────────────

# MPESA DARAJA API (via serverless function only — never expose to client)
# MPESA_CONSUMER_KEY=your_mpesa_consumer_key
# MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
# MPESA_SHORTCODE=your_mpesa_shortcode
# MPESA_PASSKEY=your_mpesa_passkey

# AFRICA'S TALKING — SMS alerts
# AFRICASTALKING_API_KEY=your_africastalking_key
# AFRICASTALKING_USERNAME=your_username